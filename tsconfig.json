/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "strict": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "@environments/*": [
        "./src/environments/*"
      ],
      "@app/*": [
        "./src/app/*"
      ]
    },
    "useDefineForClassFields": false
  },
  "include": [
    "./src/assets/translate/en.ts"
  ]
}
