{
  "name": "khitma",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e:build": "ng build --configuration production,e2e",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:update-screenshots": "playwright test --config e2e/playwright.config.ts --update-snapshots"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "firebase": "^9.0.0",
    "rxjs": "~6.6.0",
    "tslib": "^2.3.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.4",
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
    "firebase-tools": "^15.34.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jsonc-parser": "^3.0.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "typescript": "~6.0.3"
  }
}